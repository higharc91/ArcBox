{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Speech": {
    "Enabled": true,
    "Provider": "google",
    "CacheDir": ".tts-cache",
    "MaxChars": 300,
    "RequestsPerMinutePerRoom": 60,
    "Voices": {}
  }
}
