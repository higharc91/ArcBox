<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- dotnet run from any directory uses the project folder as the content root, like Visual Studio and Rider,
         so relative settings such as Web:Root (../../web/play/dist) resolve the same everywhere. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcBox.Sdk\ArcBox.Sdk.csproj" />
    <ProjectReference Include="..\..\games\Counter\Counter.Logic\Counter.Logic.csproj" />
    <ProjectReference Include="..\..\games\Redline\Redline.Logic\Redline.Logic.csproj" />
  </ItemGroup>

</Project>
