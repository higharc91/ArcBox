<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- dotnet run from any directory uses the project folder as the content root, like Visual Studio and Rider,
         so relative settings such as Web:Root (../../web/play/dist) resolve the same everywhere. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <!-- Development reads secrets such as Speech:Google:ApiKey from `dotnet user-secrets` (docs/speech-setup.md). -->
    <UserSecretsId>arcbox-server-5b0e7c1e-3f2a-4d8e-9a61-2c7d4f0b8e15</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcBox.Sdk\ArcBox.Sdk.csproj" />
    <ProjectReference Include="..\..\games\Counter\Counter.Logic\Counter.Logic.csproj" />
    <ProjectReference Include="..\..\games\Redline\Redline.Logic\Redline.Logic.csproj" />
    <ProjectReference Include="..\..\games\Tactics\Tactics.Game\Tactics.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game content packs (spec §3.6): ../../content/<gameId>/<packId>/… lands in the output and publish folders as
         content/…, which is where Content:Root points by default. An empty folder (only .gitkeep) matches nothing. -->
    <Content Include="..\..\content\**\*" Exclude="..\..\content\**\.gitkeep"
             Link="content\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
