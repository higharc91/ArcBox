  "tool_policy": {
    "preferred_static_props": "create_object_pro_flash, n_directions=1; use only schema-supported arguments.",
    "per_call_style": "Combine prompt_prefix, the region brief and asset description; pass a fitting style_image, style_options and explicit palette values on every compatible call.",
    "max_colors": 48,
    "camera_hint": "low top-down where a tool supports view; the 2:1 isometric projection remains an explicit prompt and visual check.",
    "reference_fit": "Reference native width and height must both fit the output canvas; choose a smaller approved reference instead of downscaling the art ad hoc.",
    "project_assignment": "Use add_to_project after generation when a real project/folder ID is configured. Never invent an ID.",
    "palette_limitations": "Some tools/modes do not accept palette controls. In particular animate_object v3 has no palette constraint; do not pass unsupported palette arguments. Review frames together or quantize together if needed."
  },
  "animation_policy": {
    "props": "animate_object for stored PixelLab objects; animate_image for our exported loose sprites.",
    "character_pilot": "One facing and one idle or 8-frame walk study first. Prefer skeleton-guided motion when preserving identity and our rig matters.",
    "frame_count": "Inspect delivered counts. animate_image includes the input plus generated frames; animate_object v3 can omit the reference with keep_first_frame=false. Templates have fixed counts.",
    "integration": "Output is candidate flattened RGBA art. Normalize frame bounds, anchor, facing, timing and loop continuity before packing; run our clipping and contact checks.",
    "modularity": "Keep the production body/clothing/weapon layers and explicit grip sockets. Outfit transfer redraws pixels and is not a replacement for the modular equipment system.",
    "looping": "A requested loop is not a guaranteed seamless output. Inspect the last-to-first transition and moving ground contact."
  }
