  "project": {
    "name": "Wardenflame",
    "setting": "Embers of the Vale",
    "repository": "Higharc91/ArcBox",
    "remote_project_id": null,
    "remote_project_purpose": "Organization and asset membership; does not enforce generation defaults."
  },
  "prompt_prefix": "Original grounded tactical fantasy pixel art for Wardenflame, Embers of the Vale. Three-quarter 2:1 isometric presentation, top-left light, warm highlights and cooler material shadows, selective coloured outlines, restrained clustered detail, clear silhouettes, worn practical materials. Match the supplied approved reference. Transparent background for standalone sprites. Preserve a clear ground-contact point. Background terrain must remain quieter than the characters.",
  "avoid": [
    "Photorealistic or smooth painted rendering",
    "Antialiasing or inconsistent pixel sizes",
    "Frontal or side-on props in the isometric world",
    "Unmotivated neon glows or particle effects",
    "Changing camera angle, lighting direction or ground contact between frames",
    "Skull trophies and rich military tents as generic Skarrow dressing"
  ],
  "regions": {
    "ashen_ford": "Golden-hour autumn turning cold; warm fields around Emberwick, wet ash and local river steam. Old ash is not burning. Hungry townsfolk and Skarrow clan; practical repairs and modest supplies.",
    "mirewood": "Damp willow forest, black pools, fey light in specific places, dreamlike but readable.",
    "sunscar": "Hard light, dry uplands, sandstone, old farmland burned to glass and sand; practical cloth shade and rope/timber fortifications.",
    "frostpeak": "Pale dawn, snow, ice, abandoned dwarven roads and Warden shrines; grief rather than horror.",
    "ember_keep": "Ruined Warden fortress with local infernal red light, ash and worn stone; preserve the established stone material language."
  },
