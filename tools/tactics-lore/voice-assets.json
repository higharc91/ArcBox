    "Alnilam.dd28ea90": {
      "asset": "asset_5yYJFQR4jGxYz3Lxojgd5LyK",
      "preset": "Alnilam",
      "text": "Not done yet."
    },
    "Despina.191cb376": {
      "asset": "asset_gaR1xFYbHBhALqLpQbayiA6P",
      "preset": "Despina",
      "text": "Ow. Noted."
    },
    "Despina.2109f726": {
      "asset": "asset_vyzn5eoUJT5XViRQBkUdFo1f",
      "preset": "Despina",
      "text": "Don't look so surprised."
    },
    "Despina.34aada15": {
      "asset": "asset_Btg7cerS4MT1rtkirdXQYGJK",
      "preset": "Despina",
      "text": "That went better than my last plan."
    },
    "Despina.47448009": {
      "asset": "asset_wnrMinmUCaduPhnNL2ktsu6r",
      "preset": "Despina",
      "text": "Hey! Stay with me!"
    },
    "Despina.5b282600": {
      "asset": "asset_VAq6gazTVABidyw1N6oXabbr",
      "preset": "Despina",
      "text": "And stay down."
    },
    "Despina.62220d9f": {
      "asset": "asset_YjMKhd7KJbYUePjZ3iANQxDd",
      "preset": "Despina",
      "text": "I'm fine. This is fine."
    },
    "Despina.63865a25": {
      "asset": "asset_Wpgbo82sZ6UuokvFfjrx9onj",
      "preset": "Despina",
      "text": "I owe you a drink."
    },
    "Despina.6e2ee3f3": {
      "asset": "asset_G4azEqDPqj5wX5bufWNAEcoR",
      "preset": "Despina",
      "text": "Run now, joke later."
    },
    "Despina.71500b62": {
      "asset": "asset_GidxCAXgU9HZHwWdoWdBcoTS",
      "preset": "Despina",
      "text": "Oh good. Violence."
    },
    "Despina.7549a12e": {
      "asset": "asset_YrfnJi7pGPYEgidyjs9E4zkc",
      "preset": "Despina",
      "text": "One day I'll sleep in a real bed. With a pillow. Two pillows."
    },
    "Despina.85ba4b60": {
      "asset": "asset_6avZ51pvgQZLHTmrq9Gk3zYF",
      "preset": "Despina",
      "text": "Well. This'll be memorable."
    },
    "Despina.9009ed50": {
      "asset": "asset_x7nq4Y5cVKVvouByCPZ68Dpm",
      "preset": "Despina",
      "text": "Does anyone else remember what we had for breakfast? No? Just me, then. Hopefully."
    },
    "Despina.99c22034": {
      "asset": "asset_TD5vpo84Vw8z9kXsXfqr3yjT",
      "preset": "Despina",
      "text": "Oh, that's nice. Do the other side."
    },
    "Despina.a6eb5d8e": {
      "asset": "asset_axj9wyHZTvvovT1jiYMaWp1M",
      "preset": "Despina",
      "text": "Meant to do that."
    },
    "Despina.a7ed84ce": {
      "asset": "asset_Dfx52uFeJoJSvdQdNjcZ3QR3",
      "preset": "Despina",
      "text": "And nobody even lost a memory. Probably."
    },
    "Despina.da6dc41d": {
      "asset": "asset_MerBKreykeX8vXYJbKbNvA28",
      "preset": "Despina",
      "text": "Rude of them to stand there."
    },
    "Despina.e1b9b641": {
      "asset": "asset_BvnUfkPN9KoMocaqxHJikCFA",
      "preset": "Despina",
      "text": "No, no, no. Not you. Not today."
    },
    "Erinome.0a651bb5": {
      "asset": "asset_hHg3Aocin7Z8ZvRZc2frbjEu",
      "preset": "Erinome",
      "text": "Remarkable. Thank you."
    },
    "Erinome.0d085d5b": {
      "asset": "asset_XpxofLhpKgQJo8ro9jX82yvp",
      "preset": "Erinome",
      "text": "That wasn't in my projections!"
    },
    "Erinome.75006168": {
      "asset": "asset_tvq6AWFP1bcf1MVGv14NV4bo",
      "preset": "Erinome",
      "text": "Fascinating. Hostile, but fascinating."
    },
    "Erinome.7bd51f67": {
      "asset": "asset_KVsiZJghGRoTtHwap2eGrGQh",
      "preset": "Erinome",
      "text": "This is less theoretical than I'd like."
    },
    "Erinome.824c6847": {
      "asset": "asset_kMjTR4sva5zeS2BrmxPVdZss",
      "preset": "Erinome",
      "text": "Textbook. Literally; I've read the textbook."
    },
    "Erinome.b2c50804": {
      "asset": "asset_R73aQviJxpSke7FAgtZUyuhH",
      "preset": "Erinome",
      "text": "Mind the flanks. Statistically, that's where it goes wrong."
    },
    "Erinome.b6e8dde4": {
      "asset": "asset_1FAgFG6Rg149pit1RdqXgnCg",
      "preset": "Erinome",
      "text": "Stay conscious! Talk to me!"
