      "text": "Still standing."
    },
    "Alnilam.915f88ce": {
      "asset": "asset_VeHGvBCLdt8jDD6SZrcw3Xuj",
      "preset": "Alnilam",
      "text": "That's how it's done."
    },
    "Alnilam.a4f33580": {
      "asset": "asset_ctahNFqL6ouJN9JPNYejuR8T",
      "preset": "Alnilam",
      "text": "Get some sleep. I'll take first watch."
    },
    "Alnilam.a91ccc97": {
      "asset": "asset_fpgi3zunhKfiDzR2T3giGbnk",
      "preset": "Alnilam",
      "text": "Hold the line. I've got them."
    },
    "Alnilam.b8599c71": {
