{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breach.schema.json",
  "title": "Meridian scenarios and the Breach table (rules/breach.json)",
  "type": "object",
  "required": ["scenarios", "table"],
  "properties": {
    "scenarios": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "table": {
      "type": "array",
      "items": {
        "type": "object", "required": ["anomaly", "scenarios"],
        "properties": {
          "anomaly": { "$ref": "common.schema.json#/$defs/id" },
          "tile": { "$ref": "common.schema.json#/$defs/id" },
          "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } }
        }
      }
    }
  }
}
