{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "A Meridian scenario's text and numbers (rules/scenarios/<id>.json)",
  "type": "object",
  "required": ["id", "title", "roundLimit", "roles"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string" },
    "roundLimit": { "type": "integer", "minimum": 1 },
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "side", "name", "briefing"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "side": { "type": "string" },
          "name": { "type": "string" },
          "briefing": { "type": "string", "description": "At most 120 words." },
          "objectives": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "numbers": { "type": "object", "additionalProperties": { "type": "integer" } }
  }
}
