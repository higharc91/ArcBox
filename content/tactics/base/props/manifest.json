  "notes": {
    "anchor": "the ground contact pixel; stand it on the tile centre",
    "frames": "animated props are horizontal strips; loop at fps",
    "cover": "none | half | full, for ranged attacks",
    "height": "in height steps (16 px), for line of sight",
    "layer": "absent = over (a billboard, sorted with units); ground = lies flat under units",
    "light": "a point light: see lighting"
  },
  "lighting": {
    "light": "at: image px of the light's source in frame 0 (or one list per frame for animated props, since flames sway); radius: in tiles; colour: per variant, hex; flicker: a curve name in lighting.flicker; emissive: an L8 mask strip (same frames as the sprite) of the pixels that glow by themselves",
    "place": "world position = the prop's anchor on its tile + (at - anchor) in sprite px, one sprite px = 1/16 tile across and 1/8 height step up the screen (sprites draw at 2x)",
    "godot": "an OmniLight3D per light at that point: light_color = colour, omni_range = radius tiles, light_energy = base energy x flicker[(frame + phase) % 8] where phase varies per instance; on the sprite material, emission = albedo x emissive mask, so the glowing pixels skip lighting and feed bloom",
    "flicker": {
      "fire": [
