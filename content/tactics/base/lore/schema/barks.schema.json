{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcbox.local/tactics/lore/schema/barks.schema.json",
  "title": "Barks",
  "description": "barks/<speaker>.json: short battle and camp lines for one speaker, by the moment that prompts them. The game picks one by weight from the battle RNG, so a replay says the same lines.",
  "type": "object",
  "properties": {
    "speaker": { "$ref": "common.schema.json#/$defs/id", "description": "A character id, or 'narrator'." },
    "events": {
      "type": "object",
      "propertyNames": {
        "enum": ["battle_start", "turn_start", "hit", "miss", "crit", "kill", "ally_down", "low_hp", "healed", "revived",
          "level_up", "victory", "defeat", "camp", "town"]
      },
      "additionalProperties": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/line" }, "minItems": 1 }
    }
  },
  "required": ["speaker", "events"],
  "additionalProperties": false
}
