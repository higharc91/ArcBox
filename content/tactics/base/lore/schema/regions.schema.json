{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcbox.local/tactics/lore/schema/regions.schema.json",
  "title": "Regions",
  "description": "regions.json: each biome the campaign visits, tied to its chapter card (chapters/manifest.json) and the encounters fought there.",
  "type": "object",
  "properties": {
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "replaces": { "$ref": "common.schema.json#/$defs/replaces" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "chapter": { "type": "integer", "minimum": 1 },
          "card": { "$ref": "common.schema.json#/$defs/artKey", "description": "The loading-screen card, e.g. 'chapters.mirewood'." },
          "summary": { "$ref": "common.schema.json#/$defs/text", "description": "One or two sentences for the loading card." },
          "history": { "$ref": "common.schema.json#/$defs/text" },
          "mood": { "$ref": "common.schema.json#/$defs/text", "description": "For writers, composers and voice direction." },
          "factions": { "$ref": "common.schema.json#/$defs/ids" },
          "encounters": { "$ref": "common.schema.json#/$defs/ids", "description": "Rules encounter ids set here." },
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "name": { "$ref": "common.schema.json#/$defs/text" },
                "kind": {
                  "enum": ["town", "village", "castle", "dungeon", "ruins", "tower", "camp", "port", "shrine", "lair", "forest", "mountain"],
                  "description": "The world-map icon (worldmap/manifest.json 'icon.files')."
                },
                "summary": { "$ref": "common.schema.json#/$defs/text" },
                "unlock": { "$ref": "common.schema.json#/$defs/unlock" }
              },
              "required": ["id", "name", "kind", "summary"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "chapter", "summary", "history", "mood", "places"],
        "additionalProperties": false
      }
    }
  },
  "required": ["regions"],
  "additionalProperties": false
}
