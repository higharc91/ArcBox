    {
      "id": "sq_forge_docks",
      "cast": [
        "narrator"
      ],
      "start": "look",
      "nodes": [
        {
          "id": "look",
          "lines": [
            {
              "id": "sq_narrator_007",
              "speaker": "narrator",
              "text": "Under an oiled cover, a store of charcoal has stayed dry. The dockmaster's mark releases one bundle for the town forge.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "options": [
            {
              "id": "fuel",
              "label": "Take the allotted forge bundle.",
              "to": "taken",
              "requires": [
                "sq_forge_asked"
              ],
              "unless": [
                "sq_forge_fuel",
                "sq_forge_done"
              ],
              "quest": {
                "advance": "sq_cold_forge",
                "stage": "fuel"
              },
              "sets": [
                "sq_forge_honest_fuel"
              ]
            },
            {
              "id": "leave",
              "label": "Leave the stores covered.",
              "to": "leave"
            }
          ],
          "vote": true
        },
        {
          "id": "taken",
          "lines": [
            {
              "id": "sq_narrator_008",
              "speaker": "narrator",
              "text": "Ordinary charcoal, carefully kept. Enough to put heat back into Tobin's work.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        },
        {
          "id": "leave",
          "lines": [
            {
              "id": "sq_narrator_009",
              "speaker": "narrator",
              "text": "The cover settles over the dry stores.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
