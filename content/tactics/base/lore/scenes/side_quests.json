{
  "scenes": [
    {
      "id": "sq_grain_sack",
      "cast": [
        "narrator"
      ],
      "start": "look",
      "nodes": [
        {
          "id": "look",
          "lines": [
            {
              "id": "sq_narrator_001",
              "speaker": "narrator",
              "text": "A slit seam, a scatter of seed, and a chalk mark used by the Ash Market. Someone carried this sack away before it was counted.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "options": [
            {
              "id": "trace",
              "label": "Follow the market mark.",
              "to": "noted",
              "requires": [
                "sq_grain_asked"
              ],
              "unless": [
                "sq_grain_done"
              ],
              "quest": {
                "advance": "sq_missing_grain",
                "stage": "clue"
              }
            },
            {
              "id": "leave",
              "label": "Leave the sack as it is.",
              "to": "leave"
            }
          ],
          "vote": true
        },
        {
          "id": "noted",
          "lines": [
            {
              "id": "sq_narrator_002",
              "speaker": "narrator",
              "text": "The market tally should show where the seed went.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        },
        {
          "id": "leave",
          "lines": [
            {
              "id": "sq_narrator_003",
              "speaker": "narrator",
              "text": "The seed lies cold against the stones.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        }
      ],
      "requires": [
        "sq_grain_asked"
      ],
      "unless": [
        "sq_grain_done"
      ]
    },
    {
      "id": "sq_grain_tally",
      "cast": [
        "narrator"
      ],
      "start": "look",
      "nodes": [
        {
          "id": "look",
          "lines": [
            {
              "id": "sq_narrator_004",
              "speaker": "narrator",
              "text": "Town seed, entered as a private transfer. The countermark belongs to the Marrowby account.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "options": [
            {
              "id": "record",
              "label": "Keep a careful copy of the entry.",
              "to": "noted",
              "requires": [
                "sq_grain_clue"
              ],
              "unless": [
                "sq_grain_done"
              ],
              "quest": {
                "advance": "sq_missing_grain",
                "stage": "tally"
              }
            },
            {
              "id": "leave",
              "label": "Close the tally.",
              "to": "leave"
            }
          ],
          "vote": true
        },
        {
          "id": "noted",
          "lines": [
            {
              "id": "sq_narrator_005",
              "speaker": "narrator",
              "text": "Ink, date, and countermark. Enough to ask a direct question.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        },
        {
          "id": "leave",
          "lines": [
            {
              "id": "sq_narrator_006",
              "speaker": "narrator",
              "text": "The ledger closes with a dry whisper.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        }
