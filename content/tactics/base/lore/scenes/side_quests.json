          ],
          "vote": true
        },
        {
          "id": "left",
          "lines": [
            {
              "id": "sq_narrator_011",
              "speaker": "narrator",
              "text": "You straighten the cord and leave the whistle where Pip can visit it. A small kindness, without an audience.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        },
        {
          "id": "taken",
          "lines": [
            {
              "id": "sq_narrator_012",
              "speaker": "narrator",
              "text": "You wrap the whistle for the walk back. Pip should decide what happens next.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "end": true
        },
        {
          "id": "quiet",
          "lines": [
            {
              "id": "sq_narrator_013",
              "speaker": "narrator",
              "text": "For a moment, even the river seems far away.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
