    {
      "id": "sq_whistle_grave",
      "cast": [
        "narrator"
      ],
      "start": "look",
      "nodes": [
        {
          "id": "look",
          "lines": [
            {
              "id": "sq_narrator_010",
              "speaker": "narrator",
              "text": "Annet's whistle rests beside her stone, its cord tucked out of the mud. There is no need to sound it.",
              "mood": "idle",
              "direction": "Quiet, clear storyteller; intimate and grounded, leave room for the cold."
            }
          ],
          "options": [
            {
              "id": "leave_whistle",
              "label": "Leave it here, safe beside her stone.",
              "to": "left",
              "requires": [
                "sq_whistle_asked"
              ],
              "unless": [
                "sq_whistle_done"
              ],
              "quest": {
                "complete": "sq_guards_whistle"
              },
              "sets": [
                "sq_whistle_left"
              ]
            },
            {
              "id": "bring",
              "label": "Carry it carefully to Pip.",
              "to": "taken",
              "requires": [
                "sq_whistle_asked"
              ],
              "unless": [
                "sq_whistle_found",
                "sq_whistle_done"
              ],
              "quest": {
                "advance": "sq_guards_whistle",
                "stage": "found"
              }
            },
            {
              "id": "quiet",
              "label": "Sit a moment, then leave.",
              "to": "quiet"
