{
  "quests": [
    {
      "id": "sq_missing_grain",
      "name": "Where the Grain Went",
      "giver": "halden_varrow",
      "region": "ashen_ford",
      "stages": [
        {
          "id": "asked",
          "objective": "Inspect the granary seed sacks",
          "log": "Halden asked us to trace missing seed without stirring more accusations.",
          "when": [
            "sq_grain_asked"
          ],
          "target": {
            "thing": "af_granary_sack"
          }
        },
        {
          "id": "clue",
          "objective": "Read the Ash Market tally",
          "log": "The cut sack bears a market mark. We should compare the tally.",
          "when": [
            "sq_grain_clue"
          ],
          "target": {
            "thing": "af_ash_market_tally"
          }
        },
        {
          "id": "tally",
          "objective": "Speak to Celandine or Halden",
          "log": "The tally lists town seed as a private transfer. We can confront Celandine or ask Halden to settle it quietly.",
          "when": [
            "sq_grain_tally"
          ],
          "target": {
            "person": "celandine_marrowby"
          }
        }
      ],
      "done": {
        "when": [
          "sq_grain_done"
        ],
        "log": "The seed was returned under a witnessed account. Emberwick has one less debt hidden in its stores."
      },
      "rewards": {
        "gold": 30,
        "xp": 100,
        "items": [],
        "sets": [
          "sq_grain_accounted"
        ]
      }
    },
    {
      "id": "sq_cold_forge",
      "name": "A Cold Forge",
      "giver": "tobin_fell",
      "region": "ashen_ford",
      "stages": [
        {
          "id": "asked",
          "objective": "Find fuel at the docks",
          "log": "Tobin needs ordinary dry fuel. We can inspect the dock stores or arrange a fair supply through Rook.",
          "when": [
            "sq_forge_asked"
          ],
          "target": {
            "thing": "af_dock_charcoal"
          }
        },
        {
          "id": "fuel",
          "objective": "Bring the fuel to Tobin",
          "log": "We have secured dry charcoal. It will keep the forge working without another ember debt.",
          "when": [
            "sq_forge_fuel"
          ],
          "target": {
            "person": "tobin_fell"
          }
        }
      ],
      "done": {
        "when": [
          "sq_forge_done"
        ],
        "log": "The forge has a working charcoal fire. This is useful heat, not a cure for the Vale."
      },
      "rewards": {
        "gold": 0,
        "xp": 100,
        "items": [
          {
            "item": "oil_flask",
            "count": 1
          }
        ],
        "sets": []
      }
    },
    {
      "id": "sq_guards_whistle",
      "name": "The Guard's Whistle",
      "giver": "pip_ashdown",
      "region": "ashen_ford",
      "stages": [
        {
          "id": "asked",
          "objective": "Visit Annet's grave",
          "log": "Pip asked us to find the whistle beside Annet's stone and treat the place with care.",
          "when": [
            "sq_whistle_asked"
          ],
          "target": {
            "thing": "af_grave_annet"
          }
        },
        {
          "id": "found",
          "objective": "Bring the whistle to Pip",
          "log": "We are keeping the whistle safe until we can show it to Pip.",
          "when": [
            "sq_whistle_found"
          ],
          "target": {
            "person": "pip_ashdown"
          }
        }
      ],
      "done": {
        "when": [
          "sq_whistle_done"
        ],
        "log": "We treated Annet's whistle with care. Pip knows where it belongs, and that someone listened."
      },
      "rewards": {
        "gold": 0,
        "xp": 100,
        "items": [],
        "sets": [
          "sq_whistle_remembered"
        ]
      }
    },
    {
      "id": "sq_ashmaw",
      "name": "The Cinder Hollow Bounty",
      "giver": "dagna_holt",
      "region": "ashen_ford",
      "stages": [
        {
          "id": "posted",
          "objective": "Speak to Captain Dagna",
          "log": "The Watch offers a bounty for the great grey bear hunting the Southfield pens. Recommended level: 2.",
          "when": [
            "sq_ashmaw_posted"
          ],
          "target": {
            "person": "dagna_holt"
          }
        },
        {
          "id": "accepted",
          "objective": "Find the Cinder Hollow",
          "log": "Dagna sent us to the cave below Maud\u2019s hut on the burned east bank. Recommended level: 2.",
          "when": [
            "sq_ashmaw_accepted"
          ],
          "target": {
            "thing": "af_cinder_hollow_mouth"
          }
        },
        {
          "id": "entered",
          "objective": "Search the Hollow",
          "log": "We entered the cave. The miners\u2019 tracks lead deeper into the rock.",
          "when": [
            "sq_ashmaw_entered"
          ]
        },
        {
          "id": "lair",
          "objective": "Face Ashmaw",
          "log": "Beyond the webs, a safe fire marks the last approach to Ashmaw\u2019s bed.",
          "when": [
            "sq_ashmaw_lair"
          ],
          "target": {
            "region": "cinder_hollow",
            "tile": [
              19,
              32
            ]
          }
        },
        {
          "id": "slain",
          "objective": "Bring the claw to Dagna",
          "log": "Ashmaw is dead. Take its warm ember-claw as proof, then return to Captain Dagna.",
          "when": [
            "sq_ashmaw_slain"
          ],
          "target": {
            "person": "dagna_holt"
          }
        }
      ],
      "done": {
        "when": [
          "sq_ashmaw_done"
        ],
        "log": "The boy is safe at Maud\u2019s. Dagna paid the bounty and set aside a class trinket for every companion, including those away."
      },
      "rewards": {
        "gold": 60,
        "xp": 300,
        "items": [],
        "sets": [
          "sq_ashmaw_rewarded"
        ],
        "trinkets": {
          "barbarian": "ashmaw_mantle",
          "bard": "bat_bone_flute",
          "cleric": "hearthstone_pendant",
          "druid": "ashwood_totem",
          "fighter": "ember_claw_gauntlet",
          "monk": "cinder_wraps",
          "paladin": "wardens_ember_badge",
          "ranger": "ashmaw_tooth_arrowheads",
          "rogue": "kobold_delvers_ring",
          "sorcerer": "smouldering_eye",
          "warlock": "ash_black_sigil",
          "wizard": "kobold_surveyors_lens"
        }
      }
    }
  ]
