{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcbox.local/tactics/rules/schema/injuries.schema.json",
  "title": "Injuries",
  "description": "injuries.json (spec \u00a73.8): picked by weight when a party member goes Out. Documentation only: the C# loader (Tactics.Logic PackLoader and Validation) is the authority and also checks meaning (spec \u00a74.10).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "name": {
        "type": "string"
      },
      "weight": {
        "type": "integer",
        "minimum": 1
      },
      "static": {
        "$ref": "common.schema.json#/$defs/staticMods"
      },
      "replaces": {
        "$ref": "common.schema.json#/$defs/replaces"
      },
      "hook": {
        "$ref": "common.schema.json#/$defs/passive/properties/hook",
        "description": "When the injury's effects run on its owner, e.g. onBattleStart."
      },
      "effects": {
        "$ref": "common.schema.json#/$defs/effects",
        "description": "Effects run on the owner on the hook (Deep cut: bleeding at the start of each battle)."
      },
      "mends": {
        "type": "string",
        "enum": [
          "rest",
          "spirit",
          "body"
        ]
      }
    },
    "required": [
      "id",
      "name",
      "weight",
      "static"
    ]
  }
}
