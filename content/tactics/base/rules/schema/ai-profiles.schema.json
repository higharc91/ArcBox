{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcbox.local/tactics/rules/schema/ai-profiles.schema.json",
  "title": "AI profiles",
  "description": "ai-profiles.json (spec §5.3): the planner's weight sets. Documentation only: the C# loader (Tactics.Logic PackLoader and Validation) is the authority and also checks meaning (spec §4.10).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "damage": {
        "type": "number"
      },
      "kill": {
        "type": "number"
      },
      "control": {
        "type": "number"
      },
      "heal": {
        "type": "number"
      },
      "revive": {
        "type": "number"
      },
      "caution": {
        "type": "number"
      },
      "focusFire": {
        "type": "number"
      },
      "objective": {
        "type": "number"
      },
      "hoard": {
        "type": "number"
      },
      "fleeBelowHp": {
        "type": "number"
      },
      "cruel": {
        "type": "boolean"
      },
      "replaces": {
        "$ref": "common.schema.json#/$defs/replaces"
      }
    },
    "required": [
      "id"
    ]
  }
}
