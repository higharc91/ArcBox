{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Region shops",
  "description": "Consumable trading. Haggle and rest are reserved; haggling remains off. The C# loader validates references, reachability, prices and unique keepers.",
  "type": "object",
  "required": [
    "region",
    "shops"
  ],
  "properties": {
    "region": {
      "type": "string",
      "minLength": 1
    },
    "shops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "keeper",
          "stock",
          "buys"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "keeper": {
            "type": "object",
            "properties": {
              "person": {
                "type": "integer",
                "minimum": 0
              },
              "thing": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "required": [
                  "person"
                ]
              },
              {
                "required": [
                  "thing"
                ]
              }
            ],
            "additionalProperties": false
          },
          "stock": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item",
                "count"
              ],
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    {
                      "const": "infinite"
                    }
                  ]
                },
                "restock": {
                  "enum": [
                    "never",
                    "chapter",
                    "rest"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "buys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "greeting": {
            "type": "string"
          },
          "farewell": {
            "type": "string"
          },
          "priceMod": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unless": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "haggle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "kind",
                "price"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "room",
                    "cure"
                  ]
                },
                "price": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sellRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
