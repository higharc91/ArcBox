{
  "abilities": [
    { "id": "barbarian.rage", "name": "Rage", "tier": 0, "cost": { "bonus": 1, "resource": { "rage": 1 } },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "self" } },
      "effects": [ { "apply": "raging", "rounds": 3 },
                   { "if": { "when": { "roundAtLeast": 1 },
                             "then": [ { "tempHp": { "dice": { "byLevel": { "1": "1d6", "5": "2d8", "9": "4d8" } }, "bonus": ["mod.con"] } } ] } } ],
      "presentation": { "anim": "characters.buff", "fx": "fx.rage.rage" },
      "ai": { "tags": ["buff", "defend", "self"] },
