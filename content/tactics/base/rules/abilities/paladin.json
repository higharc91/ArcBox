{
  "abilities": [
    { "id": "paladin.lay_on_hands", "name": "Lay on Hands", "tier": 0, "cost": { "bonus": 1, "resource": { "lay_on_hands": 1 } },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "heal": { "dice": "5" } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.heal.holy" },
      "ai": { "tags": ["heal", "single"] },
      "flavor": "Your healing pool holds 5 HP per paladin level each battle; each touch draws 5 of them." },
    { "id": "paladin.divine_smite", "name": "Divine Smite", "tier": 1, "cost": { "bonus": 1, "resource": { "oath": 1 } },
      "target": { "kind": "enemy", "range": 1, "los": false, "heightTolerance": 2, "area": { "shape": "single" } },
      "effects": [ { "apply": "divine_smite", "rounds": 1 } ],
      "presentation": { "anim": "characters.ready", "fx": "fx.aura.holy" },
      "ai": { "tags": ["damage", "single"] },
      "flavor": "Your next melee hit on the target before the end of your next turn deals an extra 2d8 radiant (3d8 against undead and fiends)." },
    { "id": "paladin.divine_smite_2", "name": "Divine Smite (2 Oath)", "tier": 2, "cost": { "bonus": 1, "resource": { "oath": 2 } },
      "target": { "kind": "enemy", "range": 1, "los": false, "heightTolerance": 2, "area": { "shape": "single" } },
      "effects": [ { "apply": "divine_smite_2", "rounds": 1 } ],
      "presentation": { "anim": "characters.ready", "fx": "fx.aura.holy" },
      "ai": { "tags": ["damage", "single"] },
      "flavor": "Your next melee hit on the target before the end of your next turn deals an extra 3d8 radiant (4d8 against undead and fiends)." },
    { "id": "paladin.divine_smite_3", "name": "Divine Smite (3 Oath)", "tier": 3, "cost": { "bonus": 1, "resource": { "oath": 3 } },
      "target": { "kind": "enemy", "range": 1, "los": false, "heightTolerance": 2, "area": { "shape": "single" } },
      "effects": [ { "apply": "divine_smite_3", "rounds": 1 } ],
      "presentation": { "anim": "characters.ready", "fx": "fx.aura.holy" },
      "ai": { "tags": ["damage", "single"] },
      "flavor": "Your next melee hit on the target before the end of your next turn deals an extra 4d8 radiant (5d8 against undead and fiends)." },

    { "id": "paladin.bless", "name": "Bless", "tier": 1, "cost": { "action": 1, "resource": { "oath": 1 }, "concentration": true },
      "target": { "kind": "ally", "range": 4, "los": true, "area": { "shape": "burst", "size": 1, "includeSelf": true } },
      "effects": [ { "statMod": { "mods": { "attack": 2, "saves": { "str": 2, "dex": 2, "con": 2, "int": 2, "wis": 2, "cha": 2 } },
                                  "rounds": 10, "concentration": true } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.aura.holy" },
      "ai": { "tags": ["buff", "area"] } },
    { "id": "paladin.command", "name": "Command", "tier": 1, "cost": { "action": 1, "resource": { "oath": 1 } },
      "target": { "kind": "enemy", "range": 6, "los": true, "area": { "shape": "single" } },
      "effects": [ { "save": { "stat": "wis" }, "onFail": [ { "apply": "incapacitated", "rounds": 1 } ] } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.circle.holy" },
      "ai": { "tags": ["control", "single"] },
      "flavor": "\"Halt!\" The target stands still and does nothing on its next turn." },
    { "id": "paladin.compelled_duel", "name": "Compelled Duel", "tier": 1,
      "cost": { "bonus": 1, "resource": { "oath": 1 }, "concentration": true },
      "target": { "kind": "enemy", "range": 4, "los": true, "area": { "shape": "single" } },
      "effects": [ { "save": { "stat": "wis" }, "onFail": [ { "taunt": { "rounds": 10 } } ] } ],
      "presentation": { "anim": "characters.wave", "fx": "fx.circle.holy" },
      "ai": { "tags": ["taunt", "single"] } },
    { "id": "paladin.cure_wounds", "name": "Cure Wounds", "tier": 1, "cost": { "action": 1, "resource": { "oath": 1 } },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "heal": { "dice": "2d8", "bonus": ["mod.cast"] } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.heal.holy" },
      "ai": { "tags": ["heal", "single"] } },
    { "id": "paladin.shield_of_faith", "name": "Shield of Faith", "tier": 1,
      "cost": { "bonus": 1, "resource": { "oath": 1 }, "concentration": true },
      "target": { "kind": "ally", "range": 6, "los": true, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "statMod": { "mods": { "ac": 2 }, "rounds": 10, "concentration": true } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.shield.holy" },
      "ai": { "tags": ["buff", "single"] } },

    { "id": "paladin.aid", "name": "Aid", "tier": 2, "cost": { "action": 1, "resource": { "oath": 2 } },
      "target": { "kind": "ally", "range": 4, "los": true, "area": { "shape": "burst", "size": 1, "includeSelf": true } },
      "effects": [ { "tempHp": { "dice": "5" } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.aura.holy" },
      "ai": { "tags": ["buff", "area"] } },
    { "id": "paladin.lesser_restoration", "name": "Lesser Restoration", "tier": 2, "cost": { "bonus": 1, "resource": { "oath": 2 } },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "cleanse": { "tags": ["poison"] } }, { "remove": "blinded" }, { "remove": "paralysed" } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.heal.holy" },
      "ai": { "tags": ["cleanse", "single"] } },

    { "id": "paladin.dispel_magic", "name": "Dispel Magic", "tier": 3, "cost": { "action": 1, "resource": { "oath": 3 } },
      "target": { "kind": "any_unit", "range": 6, "los": true, "area": { "shape": "single" } },
      "effects": [ { "dispel": { "concentration": true } }, { "cleanse": { "tags": ["magical"] } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.circle.holy" },
      "ai": { "tags": ["dispel", "single"] } },
    { "id": "paladin.elemental_weapon", "name": "Elemental Weapon", "tier": 3,
      "cost": { "action": 1, "resource": { "oath": 3 }, "concentration": true },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "self" } },
      "effects": [ { "apply": "elemental_weapon" } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.aura.fire" },
      "ai": { "tags": ["buff", "self"] },
      "flavor": "Your weapon blazes with elemental power: +1 to hit and +2 damage while you concentrate." }
  ],
  "passives": [
    { "id": "paladin.smite_damage", "hook": "onAttackHit",
      "when": { "all": [ { "weapon": ["melee"] }, { "targetHasCondition": "divine_smite" } ] },
      "effects": [ { "damage": { "dice": "2d8", "type": "radiant" } },
                   { "if": { "when": { "any": [ { "targetTag": "undead" }, { "targetTag": "fiend" } ] },
                             "then": [ { "damage": { "dice": "1d8", "type": "radiant" } } ] } },
                   { "remove": "divine_smite" } ] },
    { "id": "paladin.smite_damage_2", "hook": "onAttackHit",
      "when": { "all": [ { "weapon": ["melee"] }, { "targetHasCondition": "divine_smite_2" } ] },
      "effects": [ { "damage": { "dice": "3d8", "type": "radiant" } },
                   { "if": { "when": { "any": [ { "targetTag": "undead" }, { "targetTag": "fiend" } ] },
                             "then": [ { "damage": { "dice": "1d8", "type": "radiant" } } ] } },
                   { "remove": "divine_smite_2" } ] },
    { "id": "paladin.smite_damage_3", "hook": "onAttackHit",
      "when": { "all": [ { "weapon": ["melee"] }, { "targetHasCondition": "divine_smite_3" } ] },
      "effects": [ { "damage": { "dice": "4d8", "type": "radiant" } },
                   { "if": { "when": { "any": [ { "targetTag": "undead" }, { "targetTag": "fiend" } ] },
                             "then": [ { "damage": { "dice": "1d8", "type": "radiant" } } ] } },
                   { "remove": "divine_smite_3" } ] },
    { "id": "paladin.aura_of_protection_start", "hook": "onBattleStart", "target": "self",
      "effects": [ { "chain": { "times": 5, "range": 2, "effects": [ { "apply": "aura_of_protection", "rounds": 1 } ] } } ] },
    { "id": "paladin.aura_of_protection", "hook": "onTurnEnd", "target": "self",
      "effects": [ { "chain": { "times": 5, "range": 2, "effects": [ { "apply": "aura_of_protection", "rounds": 1 } ] } } ] }
  ]
}
