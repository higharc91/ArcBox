{
  "abilities": [
    { "id": "elf.fey_step", "name": "Fey Step", "tier": 0, "cost": { "bonus": 1, "uses": 2 },
      "target": { "kind": "empty_tile", "range": 4, "los": true, "area": { "shape": "single" } },
      "effects": [ { "teleport": { "range": 4 } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.misty.fey" },
      "ai": { "tags": ["move", "escape"] } },
    { "id": "dwarf.stoneskin", "name": "Stoneskin", "tier": 0, "cost": { "bonus": 1, "uses": 1 },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "self" } },
      "effects": [ { "statMod": { "mods": { "resist": ["bludgeoning", "piercing", "slashing"] }, "rounds": 1 } } ],
      "presentation": { "anim": "characters.block", "fx": "fx.shield.nature" },
      "ai": { "tags": ["defend", "self"] },
      "flavor": "Your skin takes on the hardness of the mountain's bones." },
    { "id": "tiefling.hellish_rebuke", "name": "Hellish Rebuke", "tier": 1, "cost": { "reaction": 1, "uses": 1 },
      "target": { "kind": "enemy", "range": 6, "los": true, "area": { "shape": "single" } },
      "effects": [ { "save": { "stat": "dex", "dcStat": "cha" }, "halfOnSuccess": true,
                     "onFail": [ { "damage": { "dice": "2d10", "type": "fire" } } ] } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.explosion.fire" },
      "ai": { "tags": ["damage", "single", "reactsTo:beforeHit"] },
      "flavor": "When a foe is about to strike you, hellfire answers it." },
    { "id": "aasimar.healing_hands", "name": "Healing Hands", "tier": 0, "cost": { "action": 1, "uses": 1 },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "heal": { "dice": { "byLevel": { "1": "2d4", "5": "3d4", "9": "4d4" } } } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.heal.holy" },
      "ai": { "tags": ["heal", "single"] } },
    { "id": "goliath.stones_endurance", "name": "Stone's Endurance", "tier": 0, "cost": { "reaction": 1, "uses": 2 },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "self" } },
      "effects": [ { "tempHp": { "dice": "1d12", "bonus": ["mod.con"] } } ],
      "presentation": { "anim": "characters.block", "fx": "fx.shield.nature" },
      "ai": { "tags": ["defend", "self", "reactsTo:beforeHit"] },
      "flavor": "When a blow is about to land, you shrug part of it off." },
    { "id": "dragonborn.breath_weapon", "name": "Breath Weapon", "tier": 0, "cost": { "action": 1, "uses": 2 },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "cone", "size": 3 } },
      "effects": [ { "save": { "stat": "dex", "dcStat": "con" }, "halfOnSuccess": true,
                     "onFail": [ { "damage": { "dice": { "byLevel": { "1": "1d10", "5": "2d10" } }, "type": "fire" } } ] } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.fireball.fire" },
      "ai": { "tags": ["damage", "area"] } }
  ],
  "passives": [
    { "id": "human.resourceful", "hook": "onBattleStart", "target": "self",
      "effects": [ { "grantResource": { "resource": "primary", "amount": 1, "overMax": true } } ] },
    { "id": "elf.fey_ancestry", "static": { "saveEdges": { "wis": "advantage" } } },
    { "id": "halfling.lucky", "hook": "onAttackMiss", "usesPerBattle": 1, "when": { "isSpell": false },
      "effects": [ { "attack": { "kind": "weapon" }, "onHit": [ { "damage": { "weapon": true } } ] } ] },
    { "id": "gnome.cunning", "static": { "saveEdges": { "int": "advantage", "wis": "advantage", "cha": "advantage" } } },
    { "id": "half_orc.relentless_endurance", "hook": "onDowned", "target": "self", "usesPerBattle": 1,
      "effects": [ { "revive": { "hp": 1 } } ] }
  ]
}
