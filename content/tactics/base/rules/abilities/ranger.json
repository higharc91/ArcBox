{
  "abilities": [
    { "id": "ranger.hunters_mark", "name": "Hunter's Mark", "tier": 1,
      "cost": { "bonus": 1, "resource": { "focus": 1 }, "concentration": true },
      "target": { "kind": "enemy", "range": 6, "los": true, "area": { "shape": "single" } },
      "effects": [ { "apply": "hunters_mark" } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.circle.nature" },
      "ai": { "tags": ["damage", "mark", "single"] },
      "flavor": "You mark your quarry: every hit you land on it deals an extra 1d6 force damage." },
    { "id": "ranger.vanish", "name": "Vanish", "tier": 0, "cost": { "bonus": 1, "resource": { "focus": 1 } },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "self" } },
      "effects": [ { "apply": "hidden", "rounds": 1 } ],
      "presentation": { "anim": "characters.dodge", "fx": "fx.misty.shadow" },
      "ai": { "tags": ["stealth", "buff", "self"] } },

    { "id": "ranger.cure_wounds", "name": "Cure Wounds", "tier": 1, "cost": { "action": 1, "resource": { "focus": 1 } },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "heal": { "dice": "2d8", "bonus": ["mod.cast"] } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.heal.nature" },
      "ai": { "tags": ["heal", "single"] } },
    { "id": "ranger.ensnaring_strike", "name": "Ensnaring Strike", "tier": 1,
      "cost": { "action": 1, "resource": { "focus": 1 }, "concentration": true },
      "target": { "kind": "enemy", "range": 8, "los": true, "area": { "shape": "single" } },
      "effects": [ { "attack": { "kind": "weapon" },
                     "onHit": [ { "damage": { "weapon": true } },
                                { "save": { "stat": "str" }, "onFail": [ { "apply": "ensnared", "untilSave": true } ] } ] } ],
      "presentation": { "anim": "characters.shoot", "fx": "fx.circle.nature", "projectile": "projectiles.arrow" },
      "ai": { "tags": ["damage", "control", "single"] },
      "flavor": "On a hit, thorny vines bind the target: a STR save or restrained, taking 1d6 piercing each turn until it breaks free." },
    { "id": "ranger.entangle", "name": "Entangle", "tier": 1,
      "cost": { "action": 1, "resource": { "focus": 1 }, "concentration": true },
      "target": { "kind": "tile", "range": 6, "los": true, "area": { "shape": "burst", "size": 1, "friendlyFire": true } },
      "effects": [ { "zone": { "kind": "entangle", "area": { "shape": "burst", "size": 1 }, "rounds": 10, "concentration": true,
                               "difficult": true } },
                   { "save": { "stat": "str" }, "onFail": [ { "apply": "restrained", "untilSave": true } ] } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.circle.nature" },
      "ai": { "tags": ["control", "area", "zone"] } },
    { "id": "ranger.hail_of_thorns", "name": "Hail of Thorns", "tier": 1, "cost": { "action": 1, "resource": { "focus": 1 } },
      "target": { "kind": "enemy", "range": 8, "los": true, "area": { "shape": "single" } },
      "effects": [ { "attack": { "kind": "weapon" },
                     "onHit": [ { "damage": { "weapon": true } },
                                { "chain": { "times": 4, "range": 1,
                                             "effects": [ { "save": { "stat": "dex" }, "halfOnSuccess": true,
                                                            "onFail": [ { "damage": { "dice": "1d10", "type": "piercing" } } ] } ] } } ] } ],
      "presentation": { "anim": "characters.shoot", "fx": "fx.circle.nature", "projectile": "projectiles.arrow" },
      "ai": { "tags": ["damage", "area"] },
      "flavor": "On a hit, your arrow bursts into thorns: the target and each of its allies beside it make a DEX save against 1d10 piercing." },

    { "id": "ranger.spike_growth", "name": "Spike Growth", "tier": 2,
      "cost": { "action": 1, "resource": { "focus": 2 }, "concentration": true },
      "target": { "kind": "tile", "range": 6, "los": true, "area": { "shape": "burst", "size": 2, "friendlyFire": true } },
      "effects": [ { "zone": { "kind": "spikes", "area": { "shape": "burst", "size": 2 }, "rounds": 10, "concentration": true,
                               "difficult": true,
                               "passives": [ { "id": "spike_growth.thorns", "hook": "onEnterTile", "target": "self",
                                               "effects": [ { "damage": { "dice": "2d4", "type": "piercing" } } ] } ] } } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.circle.nature" },
      "ai": { "tags": ["damage", "control", "area", "zone"] },
      "flavor": "The ground sprouts hard spikes: difficult terrain, and 2d4 piercing for every tile walked into it." },
    { "id": "ranger.barkskin", "name": "Barkskin", "tier": 2, "cost": { "bonus": 1, "resource": { "focus": 2 } },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "apply": "barkskin" } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.shield.nature" },
      "ai": { "tags": ["buff", "single"] } },
    { "id": "ranger.lesser_restoration", "name": "Lesser Restoration", "tier": 2, "cost": { "bonus": 1, "resource": { "focus": 2 } },
      "target": { "kind": "ally", "range": 1, "los": false, "area": { "shape": "single", "includeSelf": true } },
      "effects": [ { "cleanse": { "tags": ["poison"] } }, { "remove": "blinded" }, { "remove": "paralysed" } ],
      "presentation": { "anim": "characters.cast", "fx": "fx.heal.nature" },
      "ai": { "tags": ["cleanse", "single"] } },

    { "id": "ranger.lightning_arrow", "name": "Lightning Arrow", "tier": 3, "cost": { "action": 1, "resource": { "focus": 3 } },
      "target": { "kind": "enemy", "range": 8, "los": true, "area": { "shape": "single" } },
      "effects": [ { "attack": { "kind": "weapon" },
                     "onHit": [ { "damage": { "dice": "4d8", "type": "lightning" } } ],
                     "onMiss": [ { "damage": { "dice": "2d8", "type": "lightning" } } ] } ],
      "presentation": { "anim": "characters.shoot", "fx": "fx.lightning.storm", "projectile": "projectiles.arrow" },
      "ai": { "tags": ["damage", "single"] },
      "flavor": "Your arrow becomes a bolt of lightning: 4d8 lightning on a hit, half as much on a miss." },
    { "id": "ranger.conjure_barrage", "name": "Conjure Barrage", "tier": 3, "cost": { "action": 1, "resource": { "focus": 3 } },
      "target": { "kind": "self", "range": 0, "los": false, "area": { "shape": "cone", "size": 7 } },
      "effects": [ { "save": { "stat": "dex" }, "halfOnSuccess": true, "onFail": [ { "damage": { "dice": "5d8", "type": "force" } } ] } ],
      "presentation": { "anim": "characters.shoot", "fx": "fx.arrow.oak" },
      "ai": { "tags": ["damage", "area"] } }
  ],
  "passives": [
    { "id": "ranger.hunters_mark_bonus", "hook": "onAttackHit", "when": { "targetHasCondition": "hunters_mark" },
      "effects": [ { "damage": { "dice": "1d6", "type": "force" } } ] },
    { "id": "ranger.archery", "static": { "attack": 2 } },
    { "id": "ranger.roving", "static": { "move": 1 } }
  ]
}
