{ "id": "warlord_bridge", "name": "The Warlord's Bridge", "map": "warlord_bridge", "level": 5, "party": { "min": 4, "max": 6 },
  "enemies": [ { "unit": "goblin_boss", "at": [11, 5], "id": "warlord", "tag": "warlord", "level": 5 },
               { "unit": "hobgoblin", "zone": "east_bank", "count": 2, "level": 5 },
               { "unit": "goblin", "zone": "east_bank", "count": 2, "level": 5 } ],
  "xp": 900, "loot": ["goblin_camp"],
  "objectives": { "win": { "any": ["defeat:warlord", "survive:8"] } },
  "triggers": [
    { "id": "warlord_taunt", "when": { "round": 1 },
      "do": [ { "say": { "speaker": "warlord", "line": "You want my bridge? Come and take it!" } },
              { "cameraHint": "bridge" } ] },
    { "id": "ridge_archers", "when": { "round": 3 },
      "do": [ { "say": { "speaker": "warlord", "line": "Archers, to the ridge!" } },
              { "spawn": { "unit": "goblin_archer", "at": "ridge_spawn", "count": 2, "tag": "ridge_archers", "level": 5 } },
              { "cameraHint": "ridge_spawn" } ] },
    { "id": "bridge_collapse", "when": { "unitEntersZone": { "tag": "party", "zone": "bridge", "count": 2 } },
      "do": [ { "say": { "speaker": "narrator", "line": "The ropes snap, and the bridge drops into the chasm!" } },
              { "effects": [ { "alterTerrain": { "area": { "shape": "single" }, "delta": -9, "deep": true } } ], "zone": "bridge" },
              { "setFlag": "bridge_down" },
              { "cameraHint": "bridge" } ] },
    { "id": "ford_jeer", "when": { "flag": "bridge_down" },
      "do": [ { "say": { "speaker": "warlord", "line": "Ha! Try the stepping stones, if you can swim!" } },
              { "cameraHint": "ford" } ] },
    { "id": "warlord_enraged", "when": { "hpBelow": { "tag": "warlord", "percent": 50 } },
      "do": [ { "say": { "speaker": "warlord", "line": "Enough! Every one of you goes over the edge!" } },
              { "phase": { "tag": "warlord", "number": 1 } } ] }
  ] }
