{ "id": "hall_of_the_flame", "name": "The Hall of the Flame", "map": "hall_of_the_flame", "level": 10, "party": { "min": 4, "max": 6 },
  "enemies": [ { "unit": "maren_sorrel", "at": [9, 4], "id": "maren_sorrel", "tag": "maren_sorrel", "level": 10 },
               { "unit": "cult_leader", "zone": "heart", "count": 2, "level": 10, "tag": "kindled" },
               { "unit": "cultist", "zone": "north_gallery", "count": 2, "level": 10, "tag": "kindled" },
               { "unit": "cultist", "zone": "south_gallery", "count": 2, "level": 10, "tag": "kindled" } ],
  "xp": 2500, "loot": ["crypt_vault"],
  "objectives": { "win": "defeat:maren_sorrel", "lose": { "any": ["party_out", "survive:12"] } },
  "triggers": [
    { "id": "maren_ritual", "when": { "round": 1 },
      "do": [ { "say": { "speaker": "maren_sorrel", "line": "You came. I hoped you would. Stand with me and watch the Vale grow warm again." } },
              { "cameraHint": "heart" } ] },
    { "id": "dragon_wakes", "when": { "any": [ { "round": 3 }, { "hpBelow": { "tag": "maren_sorrel", "percent": 50 } } ] },
      "do": [ { "say": { "speaker": "maren_sorrel", "line": "Do you hear it? The flame's old keeper wakes. Rise, and guard the hearth!" } },
              { "spawn": { "unit": "dragon", "at": "dragon_roost", "count": 1, "tag": "dragon", "level": 10 } },
              { "cameraHint": "dragon_roost" } ] },
    { "id": "maren_zeal", "when": { "hpBelow": { "tag": "maren_sorrel", "percent": 50 } },
      "do": [ { "say": { "speaker": "maren_sorrel", "line": "Hundreds of lives burn in me. I will not let them have burned for nothing!" } },
              { "phase": { "tag": "maren_sorrel", "number": 1 } } ] },
    { "id": "dragon_fury", "when": { "hpBelow": { "tag": "dragon", "percent": 50 } },
      "do": [ { "say": { "speaker": "maren_sorrel", "line": "Burn, then! Burn them all, and let the hearth have them!" } },
              { "phase": { "tag": "dragon", "number": 1 } } ] },
    { "id": "ritual_waning", "when": { "round": 9 },
      "do": [ { "say": { "speaker": "maren_sorrel", "line": "Three more turns of the flame and it is done. You cannot stop it now." } },
              { "cameraHint": "heart" } ] }
  ] }
