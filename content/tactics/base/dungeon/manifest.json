  "propNotes": {
    "anchor": "the ground contact pixel (the tile centre under the prop); stand it on the tile centre",
    "frames": "animated props are horizontal strips; loop at fps",
    "cover": "none | half | full, for ranged attacks",
    "height": "in height steps (16 px), for line of sight",
    "facing": "'+V': drawn against a wall, facing +V (screen lower-left); mirror for a +U wall. 'U': spans the tile along U; mirror to run along V",
    "light": "'at' is the light's source pixel in the frame; colour per variant, radius in tiles, flicker names a curve in lighting.flicker"
  },
